{
  "manifest_version": 3,
  "name": "Dola AI 30s Studio Pro",
  "version": "1.0.0",
  "description": "Unlock 30s video duration, auto-extend chaining, and batch automation for Seedance 2.5 on Dola AI.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Dola AI 30s Studio Settings"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.dola.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.dola.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "icon.png"
      ],
      "matches": [
        "https://www.dola.com/*"
      ]
    }
  ]
}
